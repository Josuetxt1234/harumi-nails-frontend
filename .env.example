# Local Vite dev server. Axios uses this as baseURL (must include /api).
VITE_API_URL=http://localhost:3000/api

# Production: do not put a production URL in a committed file.
# Set VITE_API_URL in the Vercel project Environment Variables as:
#   https://YOUR-SERVICE.up.railway.app/api
# Vite inlines every VITE_* value into the browser bundle. Never prefix secrets with VITE_.
